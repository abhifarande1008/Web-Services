# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# ── Server only (never sent to the browser) ──────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact-form enquiries (comma-separate for several).
CONTACT_TO_EMAIL=
# Sender address. Must use a domain verified in Resend. Until then, leave blank
# to use "onboarding@resend.dev" (Resend only delivers it to your own account email).
RESEND_FROM_EMAIL=

# ── Public (baked into the page at build time, visible to visitors) ─────
# Leave any of these blank to hide that link on the site.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CALENDLY_URL=
